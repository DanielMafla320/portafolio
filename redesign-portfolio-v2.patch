+:root {
+  color-scheme: light;
+  --page: #f4f2ee;
+  --surface: #fff;
+  --surface-muted: #eeece7;
+  --ink: #16151a;
+  --muted: #5c5966;
+  --soft: #77737f;
+  --accent: #6d28d9;
+  --accent-hover: #5b21b6;
+  --accent-wash: #eee8f8;
+  --line: #d9d5ce;
+  --line-soft: #e8e5df;
+  --shadow: 0 18px 54px rgb(30 24 38 / 7%);
+  --button-text: #fff;
+  --font-sans: var(--font-geist-sans), "Segoe UI", sans-serif;
+  --font-mono: var(--font-geist-mono), "SFMono-Regular", monospace;
+  --font-editorial: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
+  --wrap: 1160px;
+  --header-height: 76px;
+  --ease: cubic-bezier(.2, .7, .2, 1);
+}
+
+:root[data-theme="dark"] {
+  color-scheme: dark;
+  --page: #0f0e13;
+  --surface: #17161d;
+  --surface-muted: #131219;
+  --ink: #eceaf2;
+  --muted: #b4b0c0;
+  --soft: #a5a2b2;
+  --accent: #b79cff;
+  --accent-hover: #d4c4ff;
+  --accent-wash: #211d2d;
+  --line: #2d2b38;
+  --line-soft: #24222d;
+  --shadow: 0 18px 54px rgb(0 0 0 / 24%);
+  --button-text: #17131d;
+}
+
+*, *::before, *::after { box-sizing: border-box; }
+html { scroll-behavior: smooth; scroll-padding-top: calc(var(--header-height) + 20px); }
+body { margin: 0; background: var(--page); color: var(--ink); font-family: var(--font-sans); font-size: 16px; line-height: 1.6; transition: background-color 180ms ease, color 180ms ease; }
+body, button, input, textarea { font-family: var(--font-sans); }
+button, a { -webkit-tap-highlight-color: transparent; }
+button { color: inherit; }
+a { color: inherit; }
+img { display: block; max-width: 100%; }
+::selection { color: #fff; background: #6d28d9; }
+
+.site-shell { min-height: 100vh; overflow: clip; }
+.wrap { width: min(var(--wrap), calc(100% - 56px)); margin-inline: auto; }
+.section { padding: clamp(82px, 10vw, 136px) 0; position: relative; }
+.section-anchor { scroll-margin-top: calc(var(--header-height) + 18px); }
+.section-tinted { background: var(--surface-muted); }
+.skip-link { position: fixed; top: 10px; left: 10px; z-index: 100; padding: 10px 14px; color: #fff; background: var(--accent-hover); transform: translateY(-150%); border-radius: 4px; }
+.skip-link:focus { transform: translateY(0); }
+
+.site-header { height: var(--header-height); position: sticky; top: 0; z-index: 30; background: color-mix(in srgb, var(--page) 94%, transparent); border-bottom: 1px solid var(--line); backdrop-filter: blur(14px); }
+.nav-wrap { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
+.brand, .footer-brand { color: var(--ink); text-decoration: none; font-family: var(--font-editorial); font-size: 25px; line-height: 1; letter-spacing: -.055em; font-weight: 700; white-space: nowrap; }
+.brand-period, .heading-period, .footer-brand span { color: var(--accent); }
+.nav-links { display: flex; align-items: center; justify-content: center; gap: 4px; }
+.nav-link { position: relative; padding: 10px 9px; border: 0; background: transparent; color: var(--muted); cursor: pointer; font-size: 12px; font-weight: 550; transition: color 160ms ease; white-space: nowrap; }
+.nav-link::after { content: ""; position: absolute; left: 9px; right: 9px; bottom: 3px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 180ms var(--ease); }
+.nav-link:hover, .nav-link.is-active { color: var(--ink); }
+.nav-link.is-active::after { transform: scaleX(1); }
+.nav-index { margin-right: 5px; font-family: var(--font-mono); color: var(--accent); font-size: 9px; }
+.nav-tools { display: flex; align-items: center; gap: 7px; }
+.icon-button { min-width: 38px; height: 38px; padding: 0 9px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); color: var(--ink); cursor: pointer; transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease; }
+.icon-button:hover { color: var(--accent); border-color: var(--accent); }
+.language-button { font: 600 10px var(--font-mono); }
+.menu-toggle { display: none; }
+.mobile-menu { position: absolute; top: 100%; left: 0; right: 0; background: var(--page); border-bottom: 1px solid var(--line); box-shadow: var(--shadow); }
+.mobile-menu-inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px 18px; padding-block: 16px 22px; }
+.mobile-nav-link { text-align: left; background: transparent; border: 0; border-bottom: 1px solid var(--line-soft); padding: 13px 4px; cursor: pointer; }
+
+.hero { min-height: min(790px, calc(100svh - var(--header-height))); padding: clamp(64px, 9vw, 112px) 0 24px; display: flex; flex-direction: column; justify-content: center; position: relative; }
+.hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr); align-items: center; gap: clamp(40px, 9vw, 128px); }
+.hero-copy { position: relative; z-index: 2; padding-block: 25px; }
+.eyebrow, .section-kicker { margin: 0 0 20px; font-family: var(--font-mono); color: var(--accent); font-size: 10px; font-weight: 500; letter-spacing: .085em; text-transform: uppercase; }
+.eyebrow { display: flex; align-items: center; gap: 10px; }
+.eyebrow-mark { display: inline-block; width: 7px; height: 7px; border: 1px solid var(--accent); transform: rotate(45deg); }
+.hero h1 { margin: 0; font-size: clamp(66px, 9.7vw, 132px); line-height: .91; letter-spacing: -.095em; font-weight: 550; }
+.serif-word { font-family: var(--font-editorial); font-weight: 500; font-style: italic; letter-spacing: -.09em; }
+.heading-period { color: var(--accent); }
+.hero-role { margin: 23px 0 0; color: var(--muted); font-size: clamp(16px, 2vw, 21px); letter-spacing: -.035em; }
+.hero-description { max-width: 530px; margin: 20px 0 0; color: var(--muted); font-size: 15px; line-height: 1.85; }
+.hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 31px; }
+.button { min-height: 47px; padding: 0 18px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; border: 1px solid transparent; border-radius: 4px; font-size: 12px; font-weight: 600; text-decoration: none; cursor: pointer; transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease; }
+.button:hover { transform: translateY(-2px); }
+.button-primary { background: var(--accent); color: var(--button-text); }
+.button-primary:hover { background: var(--accent-hover); color: var(--button-text); }
+.button-secondary { border-color: var(--line); background: transparent; color: var(--ink); }
+.button-secondary:hover { border-color: var(--accent); color: var(--accent); }
+.hero-contact-link { margin-top: 23px; display: inline-flex; gap: 7px; align-items: center; color: var(--muted); font-size: 12px; text-decoration: none; }
+.hero-contact-link:hover { color: var(--accent); }
+.hero-visual { width: min(100%, 430px); justify-self: center; position: relative; padding: 15px 15px 38px 28px; }
+.portrait-frame { aspect-ratio: 4 / 5; overflow: hidden; position: relative; background: var(--accent-wash); border: 1px solid var(--line); }
+.portrait-frame::after { content: ""; position: absolute; inset: 12px -12px -12px 12px; border: 1px solid var(--accent); pointer-events: none; }
+.portrait-image { object-fit: cover; object-position: 50% 35%; filter: saturate(.84); }
+.portrait-index, .portrait-caption { position: absolute; z-index: 1; color: var(--muted); font: 9px var(--font-mono); letter-spacing: .06em; }
+.portrait-index { top: 0; right: 0; writing-mode: vertical-rl; }
+.portrait-caption { bottom: 2px; left: 28px; }
+.portrait-caption span { color: var(--accent); padding-inline: 4px; }
+.hero-orbit { position: absolute; top: 13%; left: 0; width: 62px; height: 62px; display: grid; place-items: center; color: var(--accent); background: var(--page); border: 1px solid var(--line); border-radius: 50%; font-family: var(--font-editorial); font-size: 18px; font-style: italic; }
+.hero-orbit span { position: absolute; top: -5px; right: -7px; font: 16px var(--font-sans); }
+.hero-bottomline { margin-top: auto; padding-top: 35px; display: flex; justify-content: space-between; color: var(--soft); font: 9px var(--font-mono); letter-spacing: .07em; }
+
+.about-grid { display: grid; grid-template-columns: minmax(250px, .8fr) minmax(0, 1.2fr); gap: clamp(48px, 8vw, 112px); align-items: start; }
+.about-portrait { min-height: 520px; position: relative; overflow: hidden; background: var(--accent-wash); }
+.about-portrait img { object-fit: cover; object-position: center 30%; filter: saturate(.78); }
+.about-portrait::after { content: ""; position: absolute; inset: auto 0 0; height: 35%; background: linear-gradient(transparent, rgb(0 0 0 / .56)); }
+.about-image-note { position: absolute; z-index: 1; left: 20px; bottom: 18px; color: #fff; font: 9px var(--font-mono); letter-spacing: .1em; }
+.about-image-note span { color: #d0b7ff; }
+.section-title { margin: 0; color: var(--ink); font-size: clamp(36px, 5.2vw, 62px); font-weight: 500; line-height: 1.06; letter-spacing: -.075em; }
+.about-copy .section-title { margin-bottom: 28px; }
+.body-copy { margin: 0 0 14px; color: var(--muted); font-size: 14px; line-height: 1.9; transition: opacity 140ms ease; }
+.body-copy.is-changing { opacity: .45; }
+.skills-grid { margin-top: 38px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
+.skill-group { min-height: 116px; padding: 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
+.mono-label { margin: 0 0 13px; color: var(--soft); font: 9px var(--font-mono); letter-spacing: .055em; text-transform: uppercase; }
+.skill-list, .project-tags { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
+.skill-list li, .project-tags li { padding: 4px 7px; background: var(--accent-wash); color: var(--accent-hover); font-size: 10px; line-height: 1.35; }
+:root[data-theme="dark"] .skill-list li, :root[data-theme="dark"] .project-tags li { color: var(--accent); }
+
+.section-heading { margin-bottom: 47px; }
+.section-heading-split { display: flex; align-items: end; justify-content: space-between; gap: 32px; }
+.section-heading .section-kicker { margin-bottom: 13px; }
+.section-intro { max-width: 360px; margin: 0 0 6px; color: var(--muted); font-size: 13px; line-height: 1.8; }
+.projects-list { border-top: 1px solid var(--line); }
+.project-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); min-height: 320px; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
+.project-art { min-height: 300px; position: relative; overflow: hidden; background: #17141d; }
+.project-art img { object-fit: cover; object-position: center; transition: transform 500ms var(--ease); }
+.project-row:hover .project-art img { transform: scale(1.035); }
+.project-art::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(16 13 20 / .56), transparent 42%); pointer-events: none; }
+.project-art-saborify { display: grid; place-items: center; background: #d9d1c5; }
+:root[data-theme="dark"] .project-art-saborify { background: #26232d; }
+.saborify-mark { width: 164px; height: 164px; position: relative; display: grid; place-items: center; border: 1px solid rgb(22 21 26 / .35); border-radius: 50%; color: #28202c; font: italic 90px/.9 var(--font-editorial); }
+:root[data-theme="dark"] .saborify-mark { color: #eee5d7; border-color: rgb(238 234 242 / .35); }
+.saborify-mark i { position: absolute; width: 1px; height: 208px; background: rgb(22 21 26 / .25); transform: rotate(45deg); }
+.saborify-mark i:nth-of-type(2) { transform: rotate(-45deg); }
+.saborify-mark i:nth-of-type(3) { width: 208px; height: 1px; }
+.project-number, .project-art-caption { position: absolute; z-index: 1; color: #fff; font: 9px var(--font-mono); letter-spacing: .1em; }
+.project-number { top: 17px; left: 19px; }
+.project-art-caption { bottom: 18px; left: 19px; }
+.project-content { align-self: center; padding: 35px clamp(24px, 5vw, 72px); }
+.project-topline, .project-bottomline { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
+.project-topline .mono-label { margin: 0; }
+.project-status { display: inline-flex; align-items: center; gap: 5px; color: var(--accent); font: 9px var(--font-mono); text-transform: uppercase; }
+.project-status.is-upcoming { color: var(--muted); }
+.project-content h3 { margin: 24px 0 10px; font-size: clamp(26px, 3vw, 39px); line-height: 1.1; letter-spacing: -.06em; font-weight: 500; }
+.project-description { min-height: 48px; max-width: 420px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.8; }
+.project-bottomline { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--line-soft); }
+.project-tags li { font-family: var(--font-mono); font-size: 9px; }
+.project-link-label { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-size: 11px; font-weight: 600; white-space: nowrap; }
+.project-link-muted { color: var(--muted); font-weight: 450; }
+.project-row.is-not-link { cursor: default; }
+
+.testimonials-grid { display: grid; grid-template-columns: 1.08fr .92fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
+.testimonial { min-height: 260px; margin: 0; padding: 26px clamp(19px, 3vw, 38px); display: flex; flex-direction: column; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
+.testimonial-featured { grid-row: span 2; min-height: 100%; padding: clamp(27px, 4vw, 48px); background: var(--accent-wash); }
+.testimonial-index { color: var(--accent); font: 9px var(--font-mono); letter-spacing: .06em; }
+.testimonial blockquote { margin: 24px 0 30px; color: var(--ink); font-family: var(--font-editorial); font-size: clamp(19px, 2.2vw, 26px); line-height: 1.55; letter-spacing: -.018em; }
+.testimonial:not(.testimonial-featured) blockquote { font-size: clamp(17px, 1.8vw, 21px); }
+.testimonial figcaption { margin-top: auto; display: flex; align-items: center; gap: 11px; }
+.testimonial-initial { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--accent); font: italic 17px var(--font-editorial); }
+.testimonial figcaption strong, .testimonial figcaption small { display: block; }
+.testimonial figcaption strong { color: var(--ink); font-size: 11px; font-weight: 600; }
+.testimonial figcaption small { margin-top: 2px; color: var(--muted); font-size: 10px; }
+
+.experience-list { max-width: 920px; margin: 0 auto; padding: 0; list-style: none; border-top: 1px solid var(--line); }
+.experience-item { display: grid; grid-template-columns: 78px 1fr; gap: 20px; border-bottom: 1px solid var(--line); }
+.experience-index { padding-top: 27px; color: var(--accent); font: 10px var(--font-mono); }
+.experience-entry { padding: 24px 0 28px; }
+.experience-meta { display: flex; gap: 15px; align-items: center; color: var(--muted); font: 9px var(--font-mono); text-transform: uppercase; letter-spacing: .05em; }
+.experience-meta span { color: var(--accent); }
+.experience-meta time { padding-left: 15px; border-left: 1px solid var(--line); }
+.experience-entry h3 { margin: 11px 0 2px; font-size: 19px; line-height: 1.3; font-weight: 550; letter-spacing: -.035em; }
+.experience-company { margin: 0; color: var(--accent); font-size: 11px; }
+.experience-description { max-width: 680px; margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.8; }
+
+.section-contact { padding-bottom: clamp(90px, 12vw, 150px); }
+.contact-layout { display: grid; grid-template-columns: 1.1fr .9fr; gap: 22px; align-items: start; }
+.contact-panel { padding: clamp(23px, 4vw, 40px); background: var(--surface); border: 1px solid var(--line); }
+.contact-panel h3 { margin: 0 0 27px; font-size: 18px; font-weight: 500; letter-spacing: -.035em; }
+.contact-form { display: grid; grid-template-columns: 1fr; }
+.contact-form label { margin: 0 0 7px; color: var(--muted); font: 10px var(--font-mono); text-transform: uppercase; letter-spacing: .045em; }
+.contact-form input, .contact-form textarea { width: 100%; min-height: 46px; margin: 0 0 19px; padding: 12px 13px; border: 1px solid var(--line); border-radius: 3px; outline: none; background: var(--page); color: var(--ink); font-size: 12px; transition: border-color 140ms ease, background-color 140ms ease; }
+.contact-form textarea { min-height: 125px; resize: vertical; }
+.contact-form input::placeholder, .contact-form textarea::placeholder { color: var(--soft); opacity: .8; }
+.contact-form input:focus, .contact-form textarea:focus { border-color: var(--accent); }
+.contact-form .contact-submit { justify-self: start; min-width: 165px; }
+.contact-submit:disabled { cursor: wait; opacity: .75; }
+.contact-submit.status-success { background: #24734d; color: white; }
+.contact-submit.status-error { background: #a83240; color: white; }
+.form-status { min-height: 19px; margin: 10px 0 0; color: var(--muted); font-size: 11px; }
+.spin { animation: spin 900ms linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+.contact-aside { display: grid; gap: 14px; }
+.contact-details .mono-label, .contact-socials .mono-label { color: var(--ink); margin-bottom: 9px; }
+.contact-aside-copy { margin: 0 0 21px; color: var(--muted); font-size: 11px; }
+.contact-detail { padding: 13px 0; display: flex; align-items: center; gap: 13px; border-top: 1px solid var(--line-soft); color: var(--accent); }
+.contact-detail div { min-width: 0; }
+.contact-detail span, .contact-detail a, .contact-detail strong { display: block; }
+.contact-detail span { margin-bottom: 2px; color: var(--muted); font: 9px var(--font-mono); text-transform: uppercase; }
+.contact-detail a, .contact-detail strong { overflow-wrap: anywhere; color: var(--ink); font-size: 12px; font-weight: 500; text-decoration: none; }
+.contact-detail a:hover { color: var(--accent); }
+.social-links { display: flex; gap: 9px; }
+.social-links a { min-height: 39px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line); color: var(--muted); font-size: 11px; text-decoration: none; transition: color 150ms ease, border-color 150ms ease; }
+.social-links a:hover { color: var(--accent); border-color: var(--accent); }
+
+.site-footer { padding: 44px 0 18px; border-top: 1px solid var(--line); background: var(--surface-muted); }
+.footer-main { max-width: 510px; padding-bottom: 35px; }
+.footer-brand { display: inline-block; font-size: 29px; }
+.footer-main > p { max-width: 430px; margin: 14px 0 19px; color: var(--muted); font-size: 12px; line-height: 1.8; }
+.footer-socials { display: flex; gap: 8px; }
+.footer-socials a { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--line); color: var(--muted); transition: color 140ms ease, border-color 140ms ease; }
+.footer-socials a:hover { color: var(--accent); border-color: var(--accent); }
+.footer-bottom { padding-top: 15px; display: flex; align-items: center; justify-content: space-between; gap: 18px; border-top: 1px solid var(--line); color: var(--soft); font: 9px var(--font-mono); }
+.footer-bottom p { margin: 0; }
+.footer-bottom a { display: inline-flex; align-items: center; gap: 4px; color: inherit; text-decoration: none; }
+.footer-bottom a:hover { color: var(--accent); }
+
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+[hidden] { display: none !important; }
+
+@media (max-width: 1000px) {
+  .nav-links { gap: 0; }
+  .nav-link { padding-inline: 6px; font-size: 11px; }
+  .nav-index { display: none; }
+}
+
+@media (max-width: 780px) {
+  :root { --header-height: 66px; }
+  .wrap { width: min(var(--wrap), calc(100% - 40px)); }
+  .nav-links { display: none; }
+  .menu-toggle { display: inline-flex; }
+  .hero { min-height: auto; padding-top: 64px; }
+  .hero-grid { grid-template-columns: 1fr; gap: 45px; }
+  .hero-copy { padding: 0; }
+  .hero h1 { font-size: clamp(70px, 15vw, 112px); }
+  .hero-visual { width: min(80%, 390px); }
+  .hero-bottomline { margin-top: 55px; }
+  .about-grid { grid-template-columns: 1fr; gap: 40px; }
+  .about-portrait { min-height: 0; aspect-ratio: 4 / 3; }
+  .section-heading-split { align-items: start; flex-direction: column; gap: 12px; }
+  .section-intro { max-width: 520px; }
+  .project-row { grid-template-columns: 1fr; }
+  .project-art { min-height: 0; aspect-ratio: 1.55; }
+  .project-content { padding: 24px 3px 30px; }
+  .project-content h3 { margin-top: 17px; }
+  .testimonials-grid { grid-template-columns: 1fr 1fr; }
+  .testimonial-featured { grid-row: auto; grid-column: 1 / -1; min-height: 270px; }
+  .contact-layout { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 520px) {
+  .wrap { width: calc(100% - 36px); }
+  .section { padding-block: 76px; }
+  .hero { padding-top: 52px; }
+  .hero h1 { font-size: clamp(65px, 18vw, 90px); }
+  .hero-description { font-size: 13px; }
+  .hero-actions { align-items: stretch; }
+  .hero-actions .button { flex: 1; padding-inline: 11px; font-size: 10px; }
+  .hero-visual { width: 86%; }
+  .hero-bottomline { font-size: 8px; gap: 18px; }
+  .hero-bottomline span:last-child { max-width: 150px; text-align: right; }
+  .about-portrait { aspect-ratio: 1 / 1.03; }
+  .section-title { font-size: clamp(37px, 11vw, 52px); }
+  .skills-grid { grid-template-columns: 1fr; }
+  .skill-group { min-height: 0; padding: 14px; }
+  .testimonials-grid { grid-template-columns: 1fr; }
+  .testimonial-featured { grid-column: auto; }
+  .testimonial { min-height: 230px; }
+  .experience-item { grid-template-columns: 35px 1fr; gap: 8px; }
+  .experience-meta { flex-wrap: wrap; gap: 9px; }
+  .experience-meta time { padding-left: 9px; }
+  .contact-panel { padding: 22px 18px; }
+  .footer-bottom { align-items: flex-start; flex-direction: column; gap: 8px; }
+}
